# Copy to server/.env and adjust.

# Port the API (and, in production, the built React app) listens on.
# The Vite dev server reads this too, so the two always match.
# Avoid 5000 on macOS: AirPlay Receiver uses it.
PORT=3001

# PostgreSQL connection string. `docker compose up -d db` from the murasaki/
# folder starts a database that matches this default (on port 5433).
# Using a PostgreSQL installed on your computer instead? It usually listens on 5432:
#   DATABASE_URL=postgres://murasaki:murasaki@localhost:5432/murasaki
DATABASE_URL=postgres://murasaki:murasaki@localhost:5433/murasaki

# Set to "true" if your Postgres host requires SSL (most hosted providers do).
DATABASE_SSL=false

# Seed the content matrix automatically when the items table is empty.
AUTO_SEED=true

# Origin allowed to call the API from a browser in development.
CLIENT_ORIGIN=http://localhost:5173

# Log every SQL statement (true/false).
DB_LOGGING=false
